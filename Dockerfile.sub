FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir . \
    && groupadd --system --gid 10001 proxystack \
    && useradd --system --uid 10001 --gid proxystack --home-dir /nonexistent --shell /usr/sbin/nologin proxystack

USER 10001:10001

EXPOSE 3003
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:3003/health', timeout=2)"

CMD ["proxystack-sub", "serve", "--config", "/data/config.yaml"]
